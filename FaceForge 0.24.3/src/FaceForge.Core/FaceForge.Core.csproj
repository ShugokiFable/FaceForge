<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FaceForge.Core</AssemblyName>
    <RootNamespace>FaceForge.Core</RootNamespace>
    <Version>0.23.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.47.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Some SSE .bsa archives (High Poly Head) compress their morph .tri files with LZ4, which .NET
         has no built-in decoder for. -->
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <!-- Skin textures are BCn-compressed .dds (Mature Skin is BC7); decode them to texture the head. -->
    <PackageReference Include="BCnEncoder.Net" Version="2.1.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FaceForge.Core.Tests" />
  </ItemGroup>
</Project>
